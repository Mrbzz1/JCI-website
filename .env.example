# ===== RAILWAY (backend) — service variables. Never commit real values. =====
ADMIN_TOKEN=            # admin password (long, random)
JWT_SECRET=             # separate long random secret used to sign admin sessions
CORS_ORIGINS=           # extra allowed frontend origins, comma-separated, exact, no trailing slash, no "*"
                        # https://jci-oudhref.vercel.app is already allowed by default
# PORT is injected by Railway. RAILWAY_VOLUME_MOUNT_PATH is injected when a volume is attached.
# DB_DIR=               # optional override of the SQLite directory (defaults to the volume mount path)

# ===== VERCEL (frontend) — Project Settings > Environment Variables (Production) =====
# JCI_API_BASE_URL=https://<your-service>.up.railway.app
# (public value, written into public/js/runtime-config.js at build time; NEVER put secrets in Vercel)
